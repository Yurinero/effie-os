# Maintainer: Yuri <yuri@effie-os.local>
pkgname='omarchy-settings'
pkgver=4.0.0.alpha
pkgrel=1
pkgdesc='Effie OS / Omarchy user defaults, /etc/skel content, fonts, plymouth theme, and support helpers'
arch=('any')
url='https://github.com/Yurinero/effie-os'
license=('MIT')
provides=('effie-settings')
conflicts=('omarchy-settings-dev' 'effie-settings-dev')

depends=(
  'bash'
  'curl'
  'gum'
  'hicolor-icon-theme'
  'plymouth'
)

makedepends=(
  'git'
  'imagemagick'
)

backup=(
  'etc/fastfetch/config.jsonc'
  'etc/mkinitcpio.conf.d/omarchy_hooks.conf'
  'etc/mkinitcpio.conf.d/thunderbolt_module.conf'
  'etc/limine-entry-tool.d/omarchy-defaults.conf'
  'etc/limine-entry-tool.d/omarchy-uki.conf'
  'etc/docker/daemon.json'
  'etc/gnupg/dirmngr.conf'
  'etc/sysctl.d/99-omarchy-sysctl.conf'
  'etc/sysctl.d/90-omarchy-file-watchers.conf'
  'etc/modprobe.d/omarchy-usb-autosuspend.conf'
  'etc/systemd/logind.conf.d/10-ignore-power-button.conf'
  'etc/systemd/logind.conf.d/20-inhibit-delay.conf'
  'etc/systemd/resolved.conf.d/10-disable-multicast.conf'
  'etc/systemd/resolved.conf.d/20-docker-dns.conf'
  'etc/systemd/system.conf.d/10-faster-shutdown.conf'
  'etc/systemd/system/user@.service.d/10-faster-shutdown.conf'
  'etc/systemd/system/docker.service.d/no-block-boot.conf'
  'etc/systemd/system/plocate-updatedb.service.d/ac-only.conf'
  'etc/systemd/system.conf.d/20-omarchy-nofile.conf'
  'etc/systemd/user.conf.d/20-omarchy-nofile.conf'
  'etc/systemd/oomd.conf.d/10-omarchy.conf'
  'etc/sddm.conf.d/10-theme.conf'
  'etc/sddm.conf.d/10-wayland.conf'
  'etc/NetworkManager/conf.d/omarchy-wifi-powersave.conf'
)

optdepends=(
  'omarchy: Full Omarchy / Effie OS desktop'
  'inxi: System information for omarchy-debug'
  'fastfetch: System information for omarchy-upload-log'
  'limine: Bootloader drop-ins'
  'limine-mkinitcpio-hook: mkinitcpio hook integration'
  'limine-snapper-sync: Boot-entry sync for snapper snapshots'
  'zram-generator: Compressed swap generator'
  'snapper: Btrfs snapshot management'
)

install='omarchy-settings.install'

_etc_override_paths=(
  'etc/security/faillock.conf'
  'etc/nsswitch.conf'
  'etc/cups/cups-browsed.conf'
  'etc/plymouth/plymouthd.conf'
)

prepare() {
  if [[ -n "${OMARCHY_SRC:-}" ]]; then
    rm -rf "$srcdir/omarchy"
    mkdir -p "$srcdir/omarchy"
    tar -C "${OMARCHY_SRC}" --exclude='./build' --exclude='./release' --exclude='./.git' -cf - . | tar -C "$srcdir/omarchy" -xf -
  fi
}

package() {
  cd "$srcdir/omarchy"

  # 1. /etc/skel/.config from config/**
  install -d "$pkgdir/etc/skel/.config"
  cp -a config/. "$pkgdir/etc/skel/.config/"

  # 2. Fastfetch default config
  if [[ -f etc/fastfetch/config.jsonc ]]; then
    install -Dm644 etc/fastfetch/config.jsonc "$pkgdir/etc/fastfetch/config.jsonc"
  fi

  # 3. /usr/share/omarchy/config/
  install -d "$pkgdir/usr/share/omarchy/config"
  cp -a config/. "$pkgdir/usr/share/omarchy/config/"

  # 4. etc/** drop-ins
  install -d "$pkgdir/etc"
  cp -a etc/. "$pkgdir/etc/"
  if [[ -d "$pkgdir/etc/sudoers.d" ]]; then
    chmod 0750 "$pkgdir/etc/sudoers.d"
    chmod 0440 "$pkgdir/etc/sudoers.d"/*
  fi

  # 5. Upstream /etc overrides staged in /usr/share/omarchy/etc-overrides/
  install -d "$pkgdir/usr/share/omarchy/etc-overrides"
  if [[ -f default/bashrc ]]; then
    install -Dm644 default/bashrc "$pkgdir/usr/share/omarchy/etc-overrides/dot.bashrc"
  fi

  cat >"$pkgdir/usr/share/omarchy/etc-overrides/os-release" <<EOF
NAME="Effie OS"
PRETTY_NAME="Effie OS (Omarchy Fork)"
ID=effie-os
ID_LIKE="omarchy arch"
BUILD_ID="$pkgver"
VERSION_ID="$pkgver"
ANSI_COLOR="38;2;158;206;106"
HOME_URL="https://github.com/Yurinero/effie-os"
DOCUMENTATION_URL="https://github.com/Yurinero/effie-os"
SUPPORT_URL="https://github.com/Yurinero/effie-os"
BUG_REPORT_URL="https://github.com/Yurinero/effie-os/issues"
LOGO=omarchy
EOF

  for path in "${_etc_override_paths[@]}"; do
    if [[ -f "$pkgdir/$path" ]]; then
      case "$path" in
        'etc/security/faillock.conf')
          mv "$pkgdir/$path" "$pkgdir/usr/share/omarchy/etc-overrides/security-faillock.conf" ;;
        'etc/nsswitch.conf')
          mv "$pkgdir/$path" "$pkgdir/usr/share/omarchy/etc-overrides/nsswitch.conf" ;;
        'etc/cups/cups-browsed.conf')
          mv "$pkgdir/$path" "$pkgdir/usr/share/omarchy/etc-overrides/cups-cups-browsed.conf" ;;
        'etc/plymouth/plymouthd.conf')
          mv "$pkgdir/$path" "$pkgdir/usr/share/omarchy/etc-overrides/plymouth-plymouthd.conf" ;;
      esac
    fi
  done
  rmdir "$pkgdir/etc/security" 2>/dev/null || true
  rmdir "$pkgdir/etc/cups" 2>/dev/null || true
  rmdir "$pkgdir/etc/plymouth" 2>/dev/null || true

  # 6. /etc/skel/.local/share/applications from applications/**
  install -d "$pkgdir/etc/skel/.local/share/applications"
  if compgen -G 'applications/*.desktop' >/dev/null; then
    cp applications/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi
  if [[ -d applications/hidden ]] && compgen -G 'applications/hidden/*.desktop' >/dev/null; then
    cp applications/hidden/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi

  # 7. Application icons
  if [[ -d applications/icons ]] && compgen -G 'applications/icons/*' >/dev/null; then
    install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps"
    install -d "$pkgdir/usr/share/icons/hicolor/48x48/apps"
    for icon in applications/icons/*; do
      [[ -f $icon ]] || continue
      icon_name=$(basename "$icon")
      icon_id=$(printf '%s\n' "${icon_name%.*}" \
        | tr '[:upper:]' '[:lower:]' \
        | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
      case "$icon_name" in
        *.svg)
          install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon_id.svg"
          ;;
        *)
          magick "$icon" -thumbnail 256x256 -background transparent -gravity center -extent 256x256 \
            "PNG32:$pkgdir/usr/share/icons/hicolor/256x256/apps/$icon_id.png"
          magick "$icon" -thumbnail 48x48 -background transparent -gravity center -extent 48x48 \
            "PNG32:$pkgdir/usr/share/icons/hicolor/48x48/apps/$icon_id.png"
          ;;
      esac
    done
  fi

  # 8. default/** tree
  install -d "$pkgdir/usr/share/omarchy/default"
  cp -a default/. "$pkgdir/usr/share/omarchy/default/"

  # 9. Snapper config template
  if [[ -f default/snapper/root ]]; then
    install -Dm644 default/snapper/root "$pkgdir/etc/snapper/config-templates/omarchy"
  fi

  # 10. SDDM theme & sessions
  if [[ -d default/sddm/omarchy ]]; then
    install -d -m 0755 "$pkgdir/usr/share/sddm/themes"
    cp -a default/sddm/omarchy "$pkgdir/usr/share/sddm/themes/"
    find "$pkgdir/usr/share/sddm/themes/omarchy" -type d -exec chmod 0755 {} +
    find "$pkgdir/usr/share/sddm/themes/omarchy" -type f -exec chmod 0644 {} +
  fi
  if [[ -f default/sddm/hyprland.lua ]]; then
    install -Dm644 default/sddm/hyprland.lua "$pkgdir/usr/share/sddm/hyprland.lua"
  fi
  if [[ -f default/wayland-sessions/omarchy.desktop ]]; then
    install -Dm644 default/wayland-sessions/omarchy.desktop "$pkgdir/usr/local/share/wayland-sessions/omarchy.desktop"
  fi

  # 11. Plymouth theme
  if [[ -d default/plymouth ]]; then
    install -d -m 0755 "$pkgdir/usr/share/plymouth/themes/omarchy"
    cp -a default/plymouth/. "$pkgdir/usr/share/plymouth/themes/omarchy/"
    find "$pkgdir/usr/share/plymouth/themes/omarchy" -type d -exec chmod 0755 {} +
    find "$pkgdir/usr/share/plymouth/themes/omarchy" -type f -exec chmod 0644 {} +
  fi

  # 12. Fonts
  if [[ -f default/fonts/omarchy/omarchy.ttf ]]; then
    install -Dm644 default/fonts/omarchy/omarchy.ttf "$pkgdir/usr/share/fonts/omarchy/omarchy.ttf"
  fi

  # 13. System sleep hook
  if [[ -f default/systemd/system-sleep/unmount-fuse ]]; then
    install -Dm755 default/systemd/system-sleep/unmount-fuse "$pkgdir/usr/lib/systemd/system-sleep/unmount-fuse"
  fi

  # 14. Branding assets
  [[ -f logo.txt ]] && install -Dm644 logo.txt "$pkgdir/usr/share/omarchy/logo.txt"
  [[ -f logo.svg ]] && install -Dm644 logo.svg "$pkgdir/usr/share/omarchy/logo.svg"
  [[ -f icon.txt ]] && install -Dm644 icon.txt "$pkgdir/usr/share/omarchy/icon.txt"
  if [[ -f icon.png ]]; then
    install -Dm644 icon.png "$pkgdir/usr/share/omarchy/icon.png"
    install -Dm644 icon.png "$pkgdir/usr/share/pixmaps/omarchy.png"
    install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/omarchy.png"
  fi

  # 15. User-editable branding in /etc/skel
  [[ -f logo.txt ]] && install -Dm644 logo.txt "$pkgdir/etc/skel/.config/omarchy/branding/screensaver.txt"
  [[ -f icon.txt ]] && install -Dm644 icon.txt "$pkgdir/etc/skel/.config/omarchy/branding/about.txt"

  # 16. Static defaults in /etc/skel
  [[ -f default/hypr/toggles/flags.lua ]] && install -Dm644 default/hypr/toggles/flags.lua "$pkgdir/etc/skel/.local/state/omarchy/toggles/hypr/flags.lua"
  [[ -f default/nautilus-python/extensions/localsend.py ]] && install -Dm644 default/nautilus-python/extensions/localsend.py "$pkgdir/etc/skel/.local/share/nautilus-python/extensions/localsend.py"
  [[ -f default/nautilus-python/extensions/transcode.py ]] && install -Dm644 default/nautilus-python/extensions/transcode.py "$pkgdir/etc/skel/.local/share/nautilus-python/extensions/transcode.py"
  [[ -f default/tensaku/state.toml ]] && install -Dm644 default/tensaku/state.toml "$pkgdir/etc/skel/.local/state/tensaku/state.toml"

  # 17. Pre-install debug and upload binaries
  [[ -f bin/omarchy-upload-log ]] && install -Dm755 bin/omarchy-upload-log "$pkgdir/usr/bin/omarchy-upload-log"
  [[ -f bin/omarchy-debug ]] && install -Dm755 bin/omarchy-debug "$pkgdir/usr/bin/omarchy-debug"
  [[ -f bin/omarchy-debug-idle ]] && install -Dm755 bin/omarchy-debug-idle "$pkgdir/usr/bin/omarchy-debug-idle"
}
