#!/bin/bash
#
# Effie OS Developer CLI Tool
# Central entrypoint for packaging, ISO generation, testing, and QEMU execution.
#
set -euo pipefail

SCRIPT_SOURCE=$(realpath "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_SOURCE")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

usage() {
  cat <<USAGE
Effie OS Developer Utility

Usage: $(basename "$0") <command> [options]

Commands:
  pkg              Build omarchy-settings and omarchy Arch packages from local source
  iso              Build full bootable live ISO image using mkarchiso
  qemu, run        Launch Effie OS in QEMU (UEFI + KVM + VirtIO GPU)
  reset-disk       Purge the virtual test disk and UEFI NVRAM state to test a fresh install
  purge-disk       Alias for reset-disk
  test             Run CLI and Shell test suites
  acceptance       Run graphical acceptance tests in disposable VM
  clean            Remove all temporary build, packaging, and work directories
  link, install    Link 'effie-dev' and 'effie' to ~/.local/bin for global CLI access
  completion       Generate shell completion script (bash/zsh)
  help             Show this help message

Quick Examples:
  # 1. Install CLI globally into PATH:
  effie-dev link

  # 2. Build packages only:
  effie-dev pkg

  # 3. Build complete ISO:
  effie-dev iso

  # 4. Test in QEMU:
  effie-dev qemu

  # 5. Start a fresh installation on a clean 40G disk:
  effie-dev reset-disk
  effie-dev qemu --create-disk 40G

  # 6. Run test suite:
  effie-dev test
USAGE
}

if (( $# == 0 )); then
  usage
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  pkg|build-pkg|packages)
    exec "$ROOT/packaging/build-packages.sh" "$@"
    ;;
  iso|build-iso)
    exec "$ROOT/scripts/build-iso.sh" "$@"
    ;;
  qemu|run|boot)
    exec "$ROOT/scripts/run-qemu.sh" "$@"
    ;;
  test|tests)
    echo "==> Running CLI and Shell test suites..."
    exec "$ROOT/test/all" "$@"
    ;;
  acceptance)
    echo "==> Running QEMU VM with acceptance test trigger..."
    exec "$ROOT/scripts/run-qemu.sh" --run-acceptance "$@"
    ;;
  reset-disk|purge-disk|clean-disk)
    echo "==> Purging existing virtual test disks and UEFI NVRAM state..."
    rm -f "$ROOT/build"/effie-test-disk* /tmp/omarchy-iso-boot* /tmp/OVMF_VARS*
    echo "Done. Next QEMU launch will boot a fresh clean drive."
    ;;
  clean)
    echo "==> Cleaning build artifacts and caches..."
    rm -rf "$ROOT/build"
    echo "Done."
    ;;
  link|install|install-cli)
    TARGET_DIR="${HOME}/.local/bin"
    mkdir -p "$TARGET_DIR"
    ln -sf "$SCRIPT_SOURCE" "$TARGET_DIR/effie-dev"
    ln -sf "$SCRIPT_SOURCE" "$TARGET_DIR/effie"
    chmod +x "$SCRIPT_SOURCE"
    chmod +x "$ROOT/scripts/build-iso.sh" "$ROOT/scripts/run-qemu.sh" "$ROOT/packaging/build-packages.sh" "$ROOT/test/all" "$ROOT/test/cli" "$ROOT/test/shell"
    echo "==> Successfully installed CLI shortcuts in $TARGET_DIR:"
    echo "    - effie-dev -> $SCRIPT_SOURCE"
    echo "    - effie     -> $SCRIPT_SOURCE"
    echo
    echo "You can now run 'effie-dev <command>' or 'effie <command>' from anywhere."
    ;;
  completion)
    SHELL_TYPE="${1:-bash}"
    if [[ "$SHELL_TYPE" == "zsh" ]]; then
      cat <<'EOF'
#compdef effie effie-dev

_effie_dev() {
  local -a commands
  commands=(
    'pkg:Build Arch packages from local source'
    'iso:Build full bootable installer ISO'
    'qemu:Launch Effie OS in QEMU'
    'run:Launch Effie OS in QEMU'
    'reset-disk:Purge virtual test disk and UEFI state'
    'test:Run CLI and Shell test suites'
    'acceptance:Run graphical acceptance tests'
    'clean:Remove temporary build directories'
    'link:Install effie-dev to ~/.local/bin'
    'help:Show help message'
  )
  _describe 'command' commands
}

_effie_dev "$@"
EOF
    else
      cat <<'EOF'
_effie_dev_completions() {
  local cur prev commands
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  commands="pkg iso qemu run reset-disk test acceptance clean link completion help"

  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  case "$prev" in
    iso)
      COMPREPLY=( $(compgen -W "--full --minimal --clean --no-cache -o --output -h --help" -- "$cur") )
      ;;
    qemu|run)
      COMPREPLY=( $(compgen -W "--iso --disk --create-disk --gui --fullscreen --headless --archinstall --run-acceptance --no-kvm -m --memory -c --cpus -h --help" -- "$cur") )
      ;;
    pkg)
      COMPREPLY=( $(compgen -W "--clean -h --help" -- "$cur") )
      ;;
  esac
}

complete -F _effie_dev_completions effie effie-dev
EOF
    fi
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage
    exit 1
    ;;
esac
